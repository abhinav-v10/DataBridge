# Copy to .env (never commit .env). Generate the key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABRIDGE_SECRET_KEY=
DATABRIDGE_METADATA_DB_URL=sqlite:///./databridge_meta.db
# For local Docker Postgres (port 5434, see README):
# DATABRIDGE_METADATA_DB_URL=postgresql+psycopg2://databridge:databridge_dev@localhost:5434/databridge_meta
# Profiling returns data values (min/max/top values) only when true. Values are never stored. Default false.
DATABRIDGE_PROFILING_ALLOW_VALUES=false
